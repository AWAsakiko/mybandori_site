# 站点地址（部署到 Vercel 后改成你的正式域名，例如 https://bandori-guide.vercel.app）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase（在 Supabase 项目 Settings → API 中获取）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 站主密码（用于隐藏入口登录站主）
OWNER_PASSWORD=change-me-to-a-strong-password

# 可选：令牌签名密钥（不填则回退使用 OWNER_PASSWORD）
AUTH_SECRET=change-me-to-a-random-string
